# URL de la web app de Apps Script (termina en /exec). Copiar este archivo a .env.local y completar.
VITE_API_URL=

# Clave fija con la que la API autoriza `?action=getHistorial` (la entrega Backend).
# Ojo: toda variable VITE_ queda dentro del código que baja el navegador.
VITE_HISTORIAL_TOKEN=

# Asistente de IA (chat flotante):
#   mock  -> respuestas de demostración, sin backend (para diseñar y probar la interfaz)
#   on    -> usa la API real (action: "chat"); requiere que Backend la haya publicado
#   vacío -> el chat no se muestra
VITE_CHAT=
